# Boules de Givre - fichier de niveau (voir docs/LEVEL_FORMAT.md)
format 1
name "Les piliers"
hue 222
reinforcements default

# joueurs : start <1|2> <x centre> <y pieds>
start 1 336 500
start 2 464 500

# platform <x> <y> <largeur>
platform 120 360 90
platform 355 360 90
platform 590 360 90

# ladder <x gauche> <haut> <bas>
ladder 150 360 500
ladder 385 360 500
ladder 620 360 500

# laser <x centre> <haut> <bas>
laser 60 36 500
laser 740 36 500

# ball <x> <y> <taille 1-4> <left|right>
ball 250 160 4 right
ball 550 160 4 left
